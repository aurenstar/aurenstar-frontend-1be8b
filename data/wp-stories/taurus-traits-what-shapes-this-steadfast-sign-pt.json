stories/img/bg-earth.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:4.854%;top:3.552%;width:32.039%;height:6.557%;background-color:#FFFFFF;border-radius:24px\"></div><div style=\"position:absolute;left:7.767%;top:4.235%;width:26.214%;height:4.918%;\"><amp-img src=\"https://aurenstar.com/logo-aurenstar.webp\" width=\"540\" height=\"180\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 10%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:5.825%;top:48.087%;width:88.350%;height:38.798%;background-color:#FFFFFF;border-radius:28px\"></div><div style=\"position:absolute;left:11.650%;top:51.639%;width:35.922%;height:4.098%;background-color:#E73578;border-radius:15px\"></div><p style=\"position:absolute;left:11.650%;top:52.459%;width:35.922%;height:2.732%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:1.639vh;font-weight:700;color:#FFFFFF;line-height:1.25;margin:0;text-align:center;text-transform:uppercase\">Exemplo real</p><p style=\"position:absolute;left:11.650%;top:57.923%;width:76.699%;height:9.290%;font-family:Montserrat,sans-serif;font-size:3.825vh;font-weight:800;color:#3982C8;line-height:1.25;margin:0\">Constância no dia a dia</p><p style=\"position:absolute;left:11.650%;top:68.579%;width:76.699%;height:14.754%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:2.459vh;font-weight:400;color:#172B4D;line-height:1.25;margin:0\">Um colega Touro sempre entrega no prazo e mantém tudo organizado. Quer saber por que isso importa?</p></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p3\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/bg-night.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:4.854%;top:3.552%;width:32.039%;height:6.557%;background-color:#FFFFFF;border-radius:24px\"></div><div style=\"position:absolute;left:7.767%;top:4.235%;width:26.214%;height:4.918%;\"><amp-img src=\"https://aurenstar.com/logo-aurenstar.webp\" width=\"540\" height=\"180\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 10%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:5.825%;top:48.087%;width:88.350%;height:38.798%;background-color:#FFFFFF;border-radius:28px\"></div><div style=\"position:absolute;left:11.650%;top:51.639%;width:33.495%;height:4.098%;background-color:#E73578;border-radius:15px\"></div><p style=\"position:absolute;left:11.650%;top:52.459%;width:33.495%;height:2.732%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:1.639vh;font-weight:700;color:#FFFFFF;line-height:1.25;margin:0;text-align:center;text-transform:uppercase\">Curiosidade</p><p style=\"position:absolute;left:11.650%;top:57.923%;width:76.699%;height:9.290%;font-family:Montserrat,sans-serif;font-size:3.825vh;font-weight:800;color:#3982C8;line-height:1.25;margin:0\">Paciência que dá frutos</p><p style=\"position:absolute;left:11.650%;top:68.579%;width:76.699%;height:14.754%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:2.459vh;font-weight:400;color:#172B4D;line-height:1.25;margin:0\">Touro prefere preparar tudo com calma, sem pressa. Isso explica seu sucesso a longo prazo. Quer entender como?</p></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p4\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/bg-earth.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height: