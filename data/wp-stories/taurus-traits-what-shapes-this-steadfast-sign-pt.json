alc(1.8 * var(--story-page-vh));background-color:#e73578;color:#fff;border-radius:999px;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(1.6 * var(--story-page-vh));font-weight:700;line-height:1.2;text-transform:uppercase;letter-spacing:0.06em\" animate-in=\"fade-in\" animate-in-delay=\"0s\">Detalhe único</p><p style=\"margin:0 0 calc(1.6 * var(--story-page-vh)) 0;color:#fff;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(4.2 * var(--story-page-vh));font-weight:800;line-height:1.12;text-shadow:0 2px 12px rgba(0,0,0,0.6)\" animate-in=\"fly-in-bottom\" animate-in-delay=\"0.1s\">Amante do prazer</p><p style=\"margin:0;color:#fff;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(2.6 * var(--story-page-vh));font-weight:500;line-height:1.35;text-shadow:0 1px 8px rgba(0,0,0,0.65)\" animate-in=\"fade-in\" animate-in-delay=\"0.4s\">Para um Touro, uma boa comida e música são essenciais. Descubra como isso revela sua conexão com o mundo.</p></div></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p5\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/cover-v2-touro.webp\" layout=\"fill\" object-fit=\"cover\" object-position=\"100% 50%\" animate-in=\"zoom-out\" animate-in-duration=\"9s\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:absolute;left:0;top:0;width:100%;height:100%;background:linear-gradient(to bottom,rgba(0,0,0,0.35) 0%,rgba(0,0,0,0) 28%,rgba(0,0,0,0.15) 45%,rgba(0,0,0,0.92) 100%)\"></div></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:5.5%;top:3.6%;width:30%;height:5.4%\"><amp-img src=\"https://aurenstar.com/stories/img/logo-story.png\" width=\"540\" height=\"176\" layout=\"fill\" object-fit=\"contain\" object-position=\"0% 50%\" alt=\"\"></a