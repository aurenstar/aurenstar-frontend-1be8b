height:4.918%;\"><amp-img src=\"https://aurenstar.com/logo-aurenstar.webp\" width=\"540\" height=\"180\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 10%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:5.825%;top:69.945%;width:88.350%;height:16.940%;background-color:#FFFFFF;border-radius:28px\"></div><p style=\"position:absolute;left:11.650%;top:73.497%;width:76.699%;height:9.290%;font-family:Montserrat,sans-serif;font-size:3.825vh;font-weight:800;color:#3982C8;line-height:1.25;margin:0\">Lust auf mehr Astrowissen?</p></div></amp-story-grid-layer><amp-story-page-outlink layout=\"nodisplay\" theme=\"custom\" cta-accent-color=\"#E73578\" cta-accent-element=\"background\"><a href=\"https://aurenstar.com/de/blog/scorpio-personality-traits-explained\">Artikel lesen</a></amp-story-page-outlink></amp-story-page></amp-story>"
