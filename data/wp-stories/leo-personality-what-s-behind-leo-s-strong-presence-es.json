ar.com/stories/img/bg-fire.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:4.854%;top:3.552%;width:32.039%;height:6.557%;background-color:#FFFFFF;border-radius:24px\"></div><div style=\"position:absolute;left:7.767%;top:4.235%;width:26.214%;height:4.918%;\"><amp-img src=\"https://aurenstar.com/logo-aurenstar.webp\" width=\"540\" height=\"180\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 10%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:5.825%;top:48.087%;width:88.350%;height:38.798%;background-color:#FFFFFF;border-radius:28px\"></div><div style=\"position:absolute;left:11.650%;top:51.639%;width:23.786%;height:4.098%;background-color:#E73578;border-radius:15px\"></div><p style=\"position:absolute;left:11.650%;top:52.459%;width:23.786%;height:2.732%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:1.639vh;font-weight:700;color:#FFFFFF;line-height:1.25;margin:0;text-align:center;text-transform:uppercase\">Razón 1</p><p style=\"position:absolute;left:11.650%;top:57.923%;width:76.699%;height:9.290%;font-family:Montserrat,sans-serif;font-size:3.825vh;font-weight:800;color:#3982C8;line-height:1.25;margin:0\">Creatividad en acción</p><p style=\"position:absolute;left:11.650%;top:68.579%;width:76.699%;height:14.754%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:2.459vh;font-weight:400;color:#172B4D;line-height:1.25;margin:0\">Leo crea para dejar huella, ya sea con arte, ideas o energía. Hay mucho más detrás de esa chispa.</p></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p3\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/bg-night.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:4.854%;top:3.552%;width:32.039%;height:6.557%;background-color:#FFFFFF;border-radius:24px\"></div><div style=\"position:absolute;left:7.767%;top:4.235%;width:26.214%;height:4.918%;\"><amp-img src=\"https://aurenstar.com/logo-aurenstar.webp\" width=\"540\" height=\"180\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 10%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:5.825%;top:52.732%;width:88.350%;height:34.153%;background-color:#FFFFFF;border-radius:28px\"></div><div style=\"position:absolute;left:11.650%;top:56.284%;width:23.786%;height:4.098%;background-color:#E73578;border-radius:15px\"></div><p style=\"position:absolute;left:11.650%;top:57.104%;width:23.786%;height:2.732%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:1.639vh;font-weight:700;color:#FFFFFF;line-height:1.25;margin:0;text-align:center;text-transform:uppercase\">Razón 2</p><p style=\"position:absolute;left:11.650%;top:62.568%;width:76.699%;height:4.645%;font-family:Montserrat,sans-serif;font-size:3.825vh;font-weight:800;color:#3982C8;line-height:1.25;margin:0\">Orgullo y dignidad</p><p style=\"position:absolute;left:11.650%;top:68.579%;width:76.699%;height:14.754%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:2.459vh;font-weight:400;color:#172B4D;line-height:1.25;margin:0\">Para Leo, el respeto es clave. No soporta sentirse ignorado, aunque otros no vean el problema.</p></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p4\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/bg-fire.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:4.854%;top:3.552%;width:32.039%;height:6.557%;background-color:#FFFFFF;border-radius:24px\"></div><div style=\"position:absolute;left:7.767%;top:4.235%;width:26.214%;height:4.918%;\"><amp-img src=\"https://aurenstar.com/logo-aurenstar.webp\" width=\"540\" height=\"180\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 10%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:5.825%;top:48.087%;width:88.350%;height:38.798%;background-color:#FFFFFF;border-radius:28px\"></div><div style=\"position:absolute;left:11.650%;top:51.639%;width:23.786%;height:4.098%;background-color:#E73578;border-radius:15px\"></div><p style=\"position:absolute;left:11.650%;top:52.459%;width:23.786%;height:2.732%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:1.639vh;font-weight:700;color:#FFFFFF;line-height:1.25;margin:0;text-align:center;text-transform:uppercase\">Razón 3</p><p style=\"position:absolute;left:11.650%;top:57.923%;width:76.699%;height:9.290%;font-family:Montserrat,sans-serif;font-size:3.825vh;font-weight:800;color:#3982C8;line-height:1.25;margin:0\">Calidez que impacta</p><p style=\"position:absolute;left:11.650%;top:68.579%;width:76.699%;height:14.754%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:2.459vh;font-weight:400;color:#172B4D;line-height:1.25;margin:0\">Cuando Leo se preocupa, su generosidad brilla y hace sentir importantes a los demás. ¿Quieres descubrir su otra cara?</p></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p5\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/bg-night.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:4.854%;top:3.552%;width:32.039%;height:6.557%;background-color:#FFFFFF;border-radius:24px\"></div><div style=\"position:absolute;left:7.767%;top:4.235%;width:26.214%;height:4.918%;\"><amp-img src=\"https://aurenstar.com/logo-aurenstar.webp\" width=\"540\" height=\"180\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 10%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:5.825%;top:44.399%;width:88.350%;height:42.486%;background-color:#FFFFFF;border-radius:28px\"></div><div style=\"position:absolute;left:11.650%;top:47.951%;width:33.495%;height:4.098%;background-color:#E73578;border-radius:15px\"></div><p style=\"position:absolute;left:11.650%;top:48.770%;width:33.495%;height:2.732%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:1.639vh;font-weight:700;color:#FFFFFF;line-height:1.25;margin:0;text-align:center;text-transform:uppercase\">Lo esencial</p><p style=\"position:absolute;left:11.650%;top:54.235%;width:76.699%;height:9.290%;font-family:Montserrat,sans-serif;font-size:3.825vh;font-weight:800;color:#3982C8;line-height:1.25;margin:0\">Un Leo más complejo</p><p style=\"position:absolute;left:11.650%;top:64.891%;width:76.699%;height:18.443%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:2.459vh;font-weight:400;color:#172B4D;line-height:1.25;margin:0\">Confianza y sensibilidad conviven en Leo, creando un signo lleno de matices que pocos conocen. Descubre todo en el artículo.</p></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"end\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/bg-night.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:4.854%;top:3.552%;width:32.039%;height:6.557%;background-color:#FFFFFF;border-radius:24px\"></div><div style=\"position:absolute;left:7.767%;top:4.235%;width:26.214%;height:4.