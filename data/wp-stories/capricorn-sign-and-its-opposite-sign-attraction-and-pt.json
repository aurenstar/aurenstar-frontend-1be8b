ebp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:4.854%;top:3.552%;width:32.039%;height:6.557%;background-color:#FFFFFF;border-radius:24px\"></div><div style=\"position:absolute;left:7.767%;top:4.235%;width:26.214%;height:4.918%;\"><amp-img src=\"https://aurenstar.com/logo-aurenstar.webp\" width=\"540\" height=\"180\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 10%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:5.825%;top:49.044%;width:88.350%;height:37.842%;background-color:#FFFFFF;border-radius:28px\"></div><div style=\"position:absolute;left:11.650%;top:52.596%;width:28.641%;height:4.098%;background-color:#E73578;border-radius:15px\"></div><p style=\"position:absolute;left:11.650%;top:53.415%;width:28.641%;height:2.732%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:1.639vh;font-weight:700;color:#FFFFFF;line-height:1.25;margin:0;text-align:center;text-transform:uppercase\">Insight 1</p><p style=\"position:absolute;left:11.650%;top:58.880%;width:76.699%;height:4.645%;font-family:Montserrat,sans-serif;font-size:3.825vh;font-weight:800;color:#3982C8;line-height:1.25;margin:0\">Ambição vs Emoção</p><p style=\"position:absolute;left:11.650%;top:64.891%;width:76.699%;height:18.443%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:2.459vh;font-weight:400;color:#172B4D;line-height:1.25;margin:0\">Capricórnio foca em metas e sucesso, enquanto Câncer valoriza o lar e os sentimentos. Já imaginou essa combinação no dia a dia?</p></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p3\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/bg-night.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:4.854%;top:3.552%;width:32.039%;height:6.557%;background-color:#FFFFFF;border-radius:24px\"></div><div style=\"position:absolute;left:7.767%;top:4.235%;width:26.214%;height:4.918%;\"><amp-img src=\"https://aurenstar.com/logo-aurenstar.webp\" width=\"540\" height=\"180\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 10%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:5.825%;top:44.399%;width:88.350%;height:42.486%;background-color:#FFFFFF;border-radius:28px\"></div><div style=\"position:absolute;left:11.650%;top:47.951%;width:28.641%;height:4.098%;background-color:#E73578;border-radius:15px\"></div><p style=\"position:absolute;left:11.650%;top:48.770%;width:28.641%;height:2.732%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:1.639vh;font-weight:700;color:#FFFFFF;line-height:1.25;margin:0;text-align:center;text-transform:uppercase\">Insight 2</p><p style=\"position:absolute;left:11.650%;top:54.235%;width:76.699%;height:9.290%;font-family:Montserrat,sans-serif;font-size:3.825vh;font-weight:800;color:#3982C8;line-height:1.25;margin:0\">Tensão e equilíbrio</p><p style=\"position:absolute;left:11.650%;top:64.891%;width:76.699%;height:18.443%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:2.459vh;font-weight:400;color:#172B4D;line-height:1.25;margin:0\">A atitude prática de Capricórnio pode parecer fria para Câncer, que por sua vez pode ser intenso demais para Capricórnio.</p></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p4\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/bg-air.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:4.854%;top:3.552%;width:32.039%;height:6.557%;background-color:#FFFFFF;border-radius:24px\"></div><div style=\"position:absolute;left:7.767%;top:4.235%;width:26.214%;height:4.918%;\"><amp-img src=\"https://aurenstar.com/logo-aurenstar.webp\" width=\"540\" height=\"180\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 10%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:5.825%;top:52.732%;width:88.350%;height:34.153%;background-color:#FFFFFF;border-radius:28px\"></div><div style=\"position:absolute;left:11.650%;top:56.284%;width:28.641%;height:4.098%;background-color:#E73578;border-radius:15px\"></div><p style=\"position:absolute;left:11.650%;top:57.104%;width:28.641%;height:2.732%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:1.639vh;font-weight:700;color:#FFFFFF;line-height:1.25;margin:0;text-align:center;text-transform:uppercase\">Insight 3</p><p style=\"position:absolute;left:11.650%;top:62.568%;width:76.699%;height:4.645%;font-family:Montserrat,sans-serif;font-size:3.825vh;font-weight:800;color:#3982C8;line-height:1.25;margin:0\">Crescimento mútuo</p><p style=\"position:absolute;left:11.650%;top:68.579%;width:76.699%;height:14.754%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:2.459vh;font-weight:400;color:#172B4D;line-height:1.25;margin:0\">Esses signos se desafiam e aprendem juntos, equilibrando estrutura e sensibilidade. Como será esse aprendizado?</p></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p5\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/bg-night.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:4.854%;top:3.552%;width:32.039%;height:6.557%;background-color: