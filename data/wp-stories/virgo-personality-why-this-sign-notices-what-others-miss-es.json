 0 0;color:#ffd166;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(2.2 * var(--story-page-vh));font-weight:700\" animate-in=\"pulse\" animate-in-delay=\"1s\">Sigue leyendo →</p></div></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p1\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/cover-v2-virgem.webp\" layout=\"fill\" object-fit=\"cover\" object-position=\"0% 50%\" animate-in=\"zoom-out\" animate-in-duration=\"9s\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:absolute;left:0;top:0;width:100%;height:100%;background:linear-gradient(to bottom,rgba(0,0,0,0.35) 0%,rgba(0,0,0,0) 28%,rgba(0,0,0,0.15) 45%,rgba(0,0,0,0.92) 100%)\"></div></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:5.5%;top:3.6%;width:30%;height:5.4%\"><amp-img src=\"https://aurenstar.com/stories/img/logo-story.png\" width=\"540\" height=\"176\" layout=\"fill\" object-fit=\"contain\" object-position=\"0% 50%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:7%;width:86%;bottom:9%\"><p style=\"display:inline-block;margin:0 0 calc(1.6 * var(--story-page-vh)) 0;padding:calc(0.7 * var(--story-page-vh)) calc(1.8 * var(--story-page-vh));background-color:#e73578;color:#fff;border-radius:999px;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(1.6 * var(--story-page-vh));font-weight:700;line-height:1.2;text-transform:uppercase;letter-spacing:0.06em\" animate-in=\"fade-in\" animate-in-delay=\"0s\">Sorpresa</p><p style=\"margin:0 0 calc(1.6 * var(--story-page-vh)) 0;color:#fff;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(4.2 * var(--story-page-vh));font-weight:800;line-height:1.12;text-shadow:0 2px 12px rgba(0,0,0,0.6)\" animate-in=\"fly-in-bottom\" animate-in-delay=\"0.1s\">Un observador único</p><p style=\"margin:0;color:#fff;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(2.6 * var(--story-page-vh));font-weight:500;line-height:1.35;text-shadow:0 1px 8px rgba(0,0,0,0.65)\" animate-in=\"fade-in\" animate-in-delay=\"0.4s\">Virgo nota detalles que otros pasan por alto, desde pequeños cambios hasta errores que pueden crecer. ¿Qué más capta que tú no ves?</p></div></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p2\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/cover-v2-virgem.webp\" layout=\"fill\" object-fit=\"cover\" object-position=\"100% 50%\" animate-in=\"zoom-in\" animate-in-duration=\"9s\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:absolute;left:0;top:0;width:100%;height:100%;background:linear-gradient(to bottom,rgba(0,0,0,0.35) 0%,rgba(0,0,0,0) 28%,rgba(0,0,0,0.15) 45%,rgba(0,0,0,0.92) 100%)\"></div></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:5.5%;top:3.6%;width:30%;height:5.4%\"><amp-img src=\"https://aurenstar.com/stories/img/logo-story.png\" width=\"540\" height=\"176\" layout=\"fill\" object-fit=\"contain\" object-position=\"0% 50%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:7%;width:86%;bottom:9%\"><p style=\"display:inline-block;margin:0 0 calc(1.6 * var(--story-page-vh)) 0;padding:calc(0.7 * var(--story-page-vh)) calc(1.8 * var(--story-page-vh));background-color:#e73578;color:#fff;border-radius:999px;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(1.6 * var(--story-page-vh));font-weight:700;line-height:1.2;text-transform:uppercase;letter-spacing:0.06em\" animate-in=\"fade-in\" animate-in-delay=\"0s\">Razón 1</p><p style=\"margin:0 0 calc(1.6 * var(--story-page-vh)) 0;color:#fff;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(4.2 * var(--story-page-vh));font-weight:800;line-height:1.12;text-shadow:0 2px 12px rgba(0,0,0,0.6)\" animate-in=\"fly-in-bottom\" animate-in-delay=\"0.1s\">Busca sentido en todo</p><p style=\"margin:0;color:#fff;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(2.6 * var(--story-page-vh));font-weight:500;line-height:1.35;text-shadow:0 1px 8px rgba(0,0,0,0.65)\" animate-in=\"fade-in\" animate-in-delay=\"0.4s\">Para Virgo, entender cada situación es clave antes de reaccionar. ¿Sabes por qué esto lo hace tan especial?</p></div></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p3\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/cover-v2-virgem.webp\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 50%\" animate-in=\"zoom-out\" animate-in-duration=\"9s\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:absolute;left:0;top:0;width:100%;height:100%;background:linear-gradient(to bottom,rgba(0,0,0,0.35) 0%,rgba(0,0,0,0) 28%,rgba(0,0,0,0.15) 45%,rgba(0,0,0,0.92) 100%)\"></div></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:5.5%;top:3.6%;width:30%;height:5.4%\"><amp-img src=\"https://aurenstar.com/stories/img/logo-story.png\" width=\"540\" height=\"176\" layout=\"fill\" object-fit=\"contain\" object-position=\"0% 50%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:7%;width:86%;bottom:9%\"><p style=\"display:inline-block;margin:0 0 calc(1.6 * var(--story-page-vh)) 0;padding:calc(0.7 * var(--story-page-vh)) calc(1.8 * var(--story-page-vh));background-color:#e73578;color:#fff;border-radius:999px;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(1.6 * var(--story-page-vh));font-weight:700;line-height:1.2;text-transform:uppercase;letter-spacing:0.06em\" animate-in=\"fade-in\" animate-in-delay=\"0s\">Razón 2</p><p style=\"margin:0 0 calc(1.6 * var(--story-page-vh)) 0;color:#fff;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(4.2 * var(--story-page-vh));font-weight:800;line-height:1.12;text-shadow:0 2px 12px rgba(0,0,0,0.6)\" animate-in=\"fly-in-bottom\" animate-in-delay=\"0.1s\">Cuida a su manera</p><p style=\"margin:0;color:#fff;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(2.6 * var(--story-page-vh));font-weight:500;line-height:1.35;text-shadow:0 1px 8px rgba(0,0,0,0.65)\" animate-in=\"fade-in\" animate-in-delay=\"0.4s\">Su cariño no es ruidoso, sino práctico: arreglar problemas o recordar lo que necesitas. ¿Te has dado cuenta de este tipo de cuidado?</p></div></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p4\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/cover-v2-virgem.webp\" layout=\"fill\" object-fit=\"cover\" object-position=\"0% 50%\" animate-in=\"zoom-in\" animate-in-duration=\"9s\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:absolute;left:0;top:0;width:100%;height:100%;background:linear-gradient(to bottom,rgba(0,0,0,0.35) 0%,rgba(0,0,0,0) 28%,rgba(0,0,0,0.15) 45%,rgba(0,0,0,0.92) 100%)\"></div></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:5.5%;top:3.6%;width:30%;height:5.4%\"><amp-img src=\"https://aurenstar.com/stories/img/logo-story.png\" width=\"540\" height=\"176\" layout=\"fill\" object-fit=\"contain\" object-position=\"0% 50%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:7%;width:86%;bottom:9%\"><p style=\"display:inline-block;margin:0 0 calc(1.6 * var(--story-page-vh)) 0;padding:calc(0.7 * var(--story-page-vh)) calc(1.8 * var(--story-page-vh));background-color:#e73578;color:#fff;border-radius:999px;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(1.6 * var(--story-page-vh));font-weight:700;line-height:1.2;text-transform:uppercase;letter-spacing:0.06em\" animate-in=\"fade-in\" animate-in-delay=\"0s\">Dato clave</p><p style=\"margin:0 0 calc(1.6 * var(--story-page-vh)) 0;color:#fff;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(4.2 * var(--story-page-vh));font-weight:800;line-height:1.12;text-shadow:0 2px 12px rgba(0,0,0,0.6)\" animate-in=\"fly-in-bottom\" animate-in-delay=\"0.1s\">No es perfección, es mejora</p><p style=\"margin:0;color:#fff;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(2.6 * var(--story-page-vh));font-weight:500;line-height:1.35;text-shadow:0 1px 8px rgba(0,0,0,0.65)\" animate-in=\"fade-in\" animate-in-delay=\"0.4s\">Virgo busca mejorar, no la perfección absoluta. Pero, ¿qué pasa cuando esa mejora se vuelve demasiado exigente?</p></div></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p5\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/cover-v2-virgem.webp\" layout=\"fill\" object-fit=\"cover\" object-position=\"100% 50%\" animate-in=\"zoom-out\" animate-in-duration=\"9s\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:absolute;left:0;top:0;width:100%;height:100%;background:linear-gradient(to bottom,rgba(0,0,0,0.35) 0%,rgba(0,0,0,0) 28%,rgba(0,0,0,0.15) 45%,rgba(0,0,0,0.92) 100%)\"></div></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:5.5%;top:3.6%;width:30%;height:5.4%\"><amp-img src=\"https://aurenstar.com/stories/img/logo-story.png\" width=\"540\" height=\"176\" layout=\"fill\" object-fit=\"contain\" object-position=\"0% 50%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:7%;width:86%;bottom:9%\"><p style=\"display:inline-block;margin:0 0 calc(1.6 * var(--story-page-vh)) 0;padding:calc(0.7 * var(--story-page-vh)) calc(1.8 * var(--story-page-vh));background-color:#e73578;color:#fff;border-radius:999px;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(1.6 * var(--story-page-vh));font-weight:700;line-height:1.2;text-transform:uppercase;letter-spacing:0.06em\" animate-in=\"fade-in\" animate-in-delay=\"0s\">Lo más interesante</p><p style=\"margin:0 0 calc(1.6 * var(--story-page-vh)) 0;color:#fff;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(4.2 * var(--story-page-vh));font-weight:800;line-height:1.12;text-shadow:0 2px 12px rgba(0,0,0,0.6)\" animate-in=\"fly-in-bottom\" animate-in-delay=\"0.1s\">La contradicción de Virgo</p><p style=\"margin:0;color:#fff;font-family:Montserrat,-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:calc(2.6 * var(--story-page-vh));font-weight:500;line-height:1.35;text-shadow:0 1px 8px rgba(0,0,0,0.65)\" animate-in=\"fade-in\" animate-in-delay=\"0.4s\">Puede ser crítico y compasivo al mismo tiempo. En el artículo descubrirás por qué esta dualidad lo hace fascinante y cómo influye en sus relaciones.</p></div></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"end\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/cover-v2-virgem.webp\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 50%\" animate-in=\"zoom-out\" animate-in-duration=\"9s\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:absolute;left:0;top:0;width:100%;height:100%;background:linear-gradient(to bottom,rgba(0,0,0,0.45) 0%,rgba(0,0,0,0) 28%,rgba(0,0,0,0.15) 45%,rgba(0,0,0,0.94) 100%)\"></div></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\