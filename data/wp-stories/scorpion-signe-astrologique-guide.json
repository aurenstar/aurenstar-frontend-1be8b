d-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/bg-fire.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:4.854%;top:3.552%;width:32.039%;height:6.557%;background-color:#FFFFFF;border-radius:24px\"></div><div style=\"position:absolute;left:7.767%;top:4.235%;width:26.214%;height:4.918%;\"><amp-img src=\"https://aurenstar.com/logo-aurenstar.webp\" width=\"540\" height=\"180\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 10%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:5.825%;top:44.399%;width:88.350%;height:42.486%;background-color:#FFFFFF;border-radius:28px\"></div><div style=\"position:absolute;left:11.650%;top:47.951%;width:35.922%;height:4.098%;background-color:#E73578;border-radius:15px\"></div><p style=\"position:absolute;left:11.650%;top:48.770%;width:35.922%;height:2.732%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:1.639vh;font-weight:700;color:#FFFFFF;line-height:1.25;margin:0;text-align:center;text-transform:uppercase\">Personnalité</p><p style=\"position:absolute;left:11.650%;top:54.235%;width:76.699%;height:9.290%;font-family:Montserrat,sans-serif;font-size:3.825vh;font-weight:800;color:#3982C8;line-height:1.25;margin:0\">Authenticité et intensité</p><p style=\"position:absolute;left:11.650%;top:64.891%;width:76.699%;height:18.443%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:2.459vh;font-weight:400;color:#172B4D;line-height:1.25;margin:0\">Le Scorpion vit tout à fond, entre loyauté extrême et émotions fortes. Sa vérité dérange parfois... Curieux(se) d’en savoir plus ?</p></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p3\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/bg-night.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img></amp-story-grid-layer><amp-story-grid-layer template=\"fill\"><div style=\"position:relative;width:100%;height:100%\"><div style=\"position:absolute;left:4.854%;top:3.552%;width:32.039%;height:6.557%;background-color:#FFFFFF;border-radius:24px\"></div><div style=\"position:absolute;left:7.767%;top:4.235%;width:26.214%;height:4.918%;\"><amp-img src=\"https://aurenstar.com/logo-aurenstar.webp\" width=\"540\" height=\"180\" layout=\"fill\" object-fit=\"cover\" object-position=\"50% 10%\" alt=\"\"></amp-img></div><div style=\"position:absolute;left:5.825%;top:44.399%;width:88.350%;height:42.486%;background-color:#FFFFFF;border-radius:28px\"></div><div style=\"position:absolute;left:11.650%;top:47.951%;width:35.922%;height:4.098%;background-color:#E73578;border-radius:15px\"></div><p style=\"position:absolute;left:11.650%;top:48.770%;width:35.922%;height:2.732%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:1.639vh;font-weight:700;color:#FFFFFF;line-height:1.25;margin:0;text-align:center;text-transform:uppercase\">Force cachée</p><p style=\"position:absolute;left:11.650%;top:54.235%;width:76.699%;height:9.290%;font-family:Montserrat,sans-serif;font-size:3.825vh;font-weight:800;color:#3982C8;line-height:1.25;margin:0\">Intuition et persévérance</p><p style=\"position:absolute;left:11.650%;top:64.891%;width:76.699%;height:18.443%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;font-size:2.459vh;font-weight:400;color:#172B4D;line-height:1.25;margin:0\">Déterminé et intuitif, le Scorpion excelle là où il doit creuser en profondeur. Sa force est un vrai atout, mais pourquoi ?</p></div></amp-story-grid-layer></amp-story-page><amp-story-page id=\"p4\"><amp-story-grid-layer template=\"fill\"><amp-img src=\"https://aurenstar.com/stories/img/bg-fire.webp\" width=\"720\" height=\"1280\" layout=\"responsive\" alt=\"\"></amp-img><